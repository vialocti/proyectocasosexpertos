# Proveedor de IA para los agentes y el asistente: anthropic | openai
AI_PROVIDER=anthropic

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
# Opcional (modelos de razonamiento): minimal | low | medium | high. Menos esfuerzo = más rápido y barato.
# OPENAI_REASONING_EFFORT=low

# Si falta la clave del proveedor elegido, el sistema funciona en "modo demo"
# con respuestas simuladas por reglas (útil para probar la interfaz).

PORT=3000

# --- Base de datos ---
DATABASE_URL=postgres://usuario:clave@localhost:5432/casos_expertos
# DATABASE_SSL=true      # para bases administradas que exigen SSL

# --- Sesiones: generar con  openssl rand -hex 32 ---
JWT_SECRET=
# SESION_DIAS=7

# --- Administrador inicial (lo crea npm run semilla) ---
ADMIN_EMAIL=admin@tu-dominio.com
ADMIN_PASSWORD=
ADMIN_NOMBRE=Administrador
